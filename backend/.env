# VulnForge AI 2.0 - native development environment

APP_NAME=VulnForge AI 2.0
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true

DATABASE_URL=postgresql+psycopg://vulnforge_user:vulnforge123@127.0.0.1:5433/vulnforge

# V1 default lab boundary.
# Change this to the Host-Only CIDR configured in VMware Workstation.
DEFAULT_LAB_CIDR=192.168.37.0/24

SCANNER_HOSTNAME=vulnforge-scanner
SCANNER_IP=192.168.37.1

NMAP_PATH=C:\Program Files (x86)\Nmap\nmap.exe

# Conservative defaults for an isolated laboratory.
DEFAULT_SCAN_TIMEOUT_SECONDS=900
DEFAULT_SCAN_CONCURRENCY=2

# Evidence metadata retention. Actual evidence storage is implemented later.
DEFAULT_EVIDENCE_RETENTION_DAYS=90

# Comma-separated origins for the future React frontend.
CORS_ORIGINS=http://localhost:5173

